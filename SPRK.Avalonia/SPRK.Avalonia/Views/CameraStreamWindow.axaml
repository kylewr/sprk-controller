<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SPRK.Avalonia.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="SPRK.Avalonia.Views.CameraStreamWindow"
        x:DataType="vm:CameraStreamViewModel"
        Width="800" Height="600"
        Title="Camera Stream"
        CanResize="True">
  <Grid RowDefinitions="*, Auto">
    <!-- Main camera view -->
    <Panel Grid.Row="0">
      <Image Source="{Binding CurrentFrame}" Stretch="Uniform"/>
      <TextBlock Text="Loading camera stream..."
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 FontSize="16"
                 Foreground="Gray"
                 IsVisible="{Binding !IsLoaded}"/>
    </Panel>

    <!-- Status bar -->
    <Border Grid.Row="1" 
            Background="#1E1E1E" 
            BorderBrush="#333333" 
            BorderThickness="0,1,0,0"
            Padding="12,8">
      <Grid ColumnDefinitions="Auto, *, Auto">
        <!-- Connection status indicator -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Ellipse Width="10" Height="10" VerticalAlignment="Center">
            <Ellipse.Fill>
              <SolidColorBrush Color="{Binding IsLoaded, Converter={x:Static vm:BoolToColorConverter.Instance}}"/>
            </Ellipse.Fill>
          </Ellipse>
          <TextBlock Text="{Binding StatusText}" 
                     Foreground="#CCCCCC" 
                     FontSize="12"
                     VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Stream info (right side) -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <TextBlock Text="{Binding FrameInfo}" 
                     Foreground="#888888" 
                     FontSize="11"
                     VerticalAlignment="Center"
                     IsVisible="{Binding IsLoaded}"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>