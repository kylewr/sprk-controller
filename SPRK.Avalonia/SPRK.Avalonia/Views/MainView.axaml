<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SPRK.Avalonia.ViewModels"
             xmlns:conv="using:SPRK.Avalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="967" d:DesignHeight="568"
             x:Class="SPRK.Avalonia.Views.MainView"
             x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <UserControl.Styles>
    <!-- Style for read-only TextBoxes to prevent hover color changes -->
    <Style Selector="TextBox.readonly">
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
      <Setter Property="Cursor" Value="Arrow"/>
    </Style>
    <Style Selector="TextBox.readonly:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{Binding $parent[TextBox].Background}"/>
    </Style>
    <Style Selector="TextBox.readonly:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{Binding $parent[TextBox].Background}"/>
    </Style>
    <!-- Modern compact tab styling -->
    <Style Selector="TabControl.compact TabItem">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- Menu Bar -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_Input">
        <MenuItem Header="_Rescan Joystick" InputGesture="F1"/>
        <Separator/>
        <MenuItem Header="Use _Keyboard Input" InputGesture="Ctrl+B" 
                  IsChecked="{Binding UseKeyboard}" />
      </MenuItem>
      <MenuItem Header="_Preferences">
        <!--<MenuItem Header="_Use Background Image"/>-->
        <MenuItem Header="Show _Tips" 
                  Command="{Binding ToggleShowTipsCommand}">
          <MenuItem.Icon>
            <CheckBox IsChecked="{Binding ShowTips}" 
                      IsHitTestVisible="False"/>
          </MenuItem.Icon>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_More Information" Command="{Binding OpenWebsiteCommand}"/>
        <Separator/>
        <MenuItem Header="_About" Command="{Binding ShowAboutCommand}"/>
      </MenuItem>
    </Menu>

    <!-- Status Bar -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" 
                Background="#F0F0F0" Height="36" Spacing="50">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
        <Image Source="avares://SPRK.Avalonia/Assets/star.png" 
               Width="20" Height="20" Margin="0,0,8,0"/>
        <TextBlock Text="{Binding AppTitle}" 
                   VerticalAlignment="Center"
                   FontSize="14"/>
      </StackPanel>
      <Border Background="{Binding RobotStatusColor}" Padding="8,4" CornerRadius="2"
              VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Image Source="{Binding RobotStatusIcon}" Width="16" Height="16"/>
          <TextBlock Text="{Binding RobotStatusText}" 
                     FontSize="14" Foreground="White"/>
        </StackPanel>
      </Border>
      <Border Background="{Binding ControllerStatusColor}" Padding="8,4" CornerRadius="2"
              VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Image Source="{Binding ControllerIcon}" Width="16" Height="16"/>
          <TextBlock Text="{Binding ControllerStatusText}" 
                     FontSize="14" Foreground="White"/>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Main Content Panel -->
    <Panel Margin="11,6">
      <Grid RowDefinitions="85,8,24,54,82,42,*" 
            ColumnDefinitions="159,98,197,*"
            Margin="0,8,0,0">
        
        <!-- Row 0, Col 0-2: Connect Button -->
        <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                Content="{Binding ConnectButtonText}"
                Command="{Binding ConnectCommand}"
                IsEnabled="{Binding CanConnect}"
                FontSize="20"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"/>
        
        <!-- Row 0, Col 3: Connection Settings -->
        <Grid Grid.Row="0" Grid.Column="3" 
              ColumnDefinitions="*,140"
              Margin="16,0,0,0">
          <StackPanel Grid.Column="0">
            <TextBlock Text="Robot Hostname/IP" 
                       FontWeight="SemiBold" FontSize="14"
                       Margin="0,4,0,4"/>
            <ComboBox IsEditable="True"
                      Text="{Binding Hostname}"
                      ItemsSource="{Binding SavedHostsList}"
                      IsEnabled="{Binding !IsConnected}"
                      HorizontalAlignment="Stretch"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="12,0,0,0">
            <TextBlock Text="Port" 
                       FontWeight="SemiBold" FontSize="14"
                       Margin="0,4,0,4"/>
            <NumericUpDown Value="{Binding Port}"
                           Minimum="1" Maximum="65535"
                           IsEnabled="{Binding !IsConnected}"
                           HorizontalAlignment="Stretch"/>
          </StackPanel>
        </Grid>
        
        <!-- Row 2, Col 0: Status Label -->
        <TextBlock Grid.Row="2" Grid.Column="0" 
                   Text="Status" 
                   FontWeight="SemiBold" FontSize="14"
                   VerticalAlignment="Bottom"/>
        
        <!-- Row 3, Col 0-2: Robot State TextBox -->
        <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                 Classes="readonly"
                 Text="{Binding RobotStateText}"
                 Background="{Binding RobotStateColor}"
                 FontSize="20" FontWeight="Bold"
                 TextAlignment="Center"
                 VerticalContentAlignment="Center"
                 BorderThickness="1"
                 Margin="0,4"/>
        
        <!-- Row 2-4, Col 3: Robot Info Panel (only when connected) -->
        <Grid Grid.Row="2" Grid.Column="3" Grid.RowSpan="3"
              IsVisible="{Binding IsConnected}"
              ColumnDefinitions="*,Auto"
              RowDefinitions="*"
              Margin="16,0,0,0">
          
          <!-- Tabbed Control for Auton and Robot Options -->
          <TabControl Grid.Column="0" Classes="compact" Margin="0,0,16,0">
            <!-- Auton Tab -->
            <TabItem Header="Auton">
              <StackPanel Margin="0,8,0,0">
                <TextBlock Text="Select Autonomous" 
                           FontWeight="SemiBold" FontSize="12"
                           Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding AutonList}"
                          SelectedItem="{Binding SelectedAuton}"
                          PlaceholderText="Select..."
                          HorizontalAlignment="Stretch"
                          IsEnabled="{Binding !DisableEnabled}"/>
              </StackPanel>
            </TabItem>
            
            <!-- Key View Tab -->
            <TabItem Header="Key View">
              <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0" VerticalAlignment="Top">
                <!-- Left Stick (WASD) -->
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock Text="Left Stick" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                  <Grid ColumnDefinitions="28,28,28" RowDefinitions="28,28">
                    <Border Grid.Row="0" Grid.Column="1" Background="{Binding KeyW, Converter={x:Static conv:BoolConverters.ToBoxBrushes}}" 
                            BorderBrush="Gray" BorderThickness="1" CornerRadius="2">
                      <TextBlock Text="W" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" Background="{Binding KeyA, Converter={x:Static conv:BoolConverters.ToBoxBrushes}}"
                            BorderBrush="Gray" BorderThickness="1" CornerRadius="2">
                      <TextBlock Text="A" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Background="{Binding KeyS, Converter={x:Static conv:BoolConverters.ToBoxBrushes}}"
                            BorderBrush="Gray" BorderThickness="1" CornerRadius="2">
                      <TextBlock Text="S" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2" Background="{Binding KeyD, Converter={x:Static conv:BoolConverters.ToBoxBrushes}}"
                            BorderBrush="Gray" BorderThickness="1" CornerRadius="2">
                      <TextBlock Text="D" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                    </Border>
                  </Grid>
                </StackPanel>
                
                <!-- Right Stick (Arrow Keys) -->
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock Text="Right Stick" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                  <Grid ColumnDefinitions="28,28,28" RowDefinitions="28,28">
                    <Border Grid.Row="0" Grid.Column="1" Background="{Binding KeyUp, Converter={x:Static conv:BoolConverters.ToBoxBrushes}}"
                            BorderBrush="Gray" BorderThickness="1" CornerRadius="2">
                      <TextBlock Text="↑" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" Background="{Binding KeyLeft, Converter={x:Static conv:BoolConverters.ToBoxBrushes}}"
                            BorderBrush="Gray" BorderThickness="1" CornerRadius="2">
                      <TextBlock Text="←" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Background="{Binding KeyDown, Converter={x:Static conv:BoolConverters.ToBoxBrushes}}"
                            BorderBrush="Gray" BorderThickness="1" CornerRadius="2">
                      <TextBlock Text="↓" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2" Background="{Binding KeyRight, Converter={x:Static conv:BoolConverters.ToBoxBrushes}}"
                            BorderBrush="Gray" BorderThickness="1" CornerRadius="2">
                      <TextBlock Text="→" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                    </Border>
                  </Grid>
                </StackPanel>
                
                <!-- Triggers and Bumpers -->
                <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="28,28" VerticalAlignment="Bottom">
                  <Border Grid.Row="0" Grid.Column="0" Background="{Binding KeyQ, Converter={x:Static conv:BoolConverters.ToBoxBrushes}}"
                          BorderBrush="Gray" BorderThickness="1" CornerRadius="2" Padding="6,2" Margin="0,0,4,0">
                    <TextBlock Text="Q/LT" FontSize="10" VerticalAlignment="Center"/>
                  </Border>
                  <Border Grid.Row="0" Grid.Column="1" Background="{Binding KeyE, Converter={x:Static conv:BoolConverters.ToBoxBrushes}}"
                          BorderBrush="Gray" BorderThickness="1" CornerRadius="2" Padding="6,2">
                    <TextBlock Text="E/RT" FontSize="10" VerticalAlignment="Center"/>
                  </Border>
                  <Border Grid.Row="1" Grid.Column="0" Background="{Binding KeyU, Converter={x:Static conv:BoolConverters.ToBoxBrushes}}"
                          BorderBrush="Gray" BorderThickness="1" CornerRadius="2" Padding="6,2" Margin="0,0,4,0">
                    <TextBlock Text="U/LB" FontSize="10" VerticalAlignment="Center"/>
                  </Border>
                  <Border Grid.Row="1" Grid.Column="1" Background="{Binding KeyO, Converter={x:Static conv:BoolConverters.ToBoxBrushes}}"
                          BorderBrush="Gray" BorderThickness="1" CornerRadius="2" Padding="6,2">
                    <TextBlock Text="O/RB" FontSize="10" VerticalAlignment="Center"/>
                  </Border>
                </Grid>
              </StackPanel>
            </TabItem>
            
            <!-- Robot Options Tab -->
            <TabItem Header="Options">
              <StackPanel Margin="0,8,0,0" Spacing="8">
                <Button Content="_Kill Robot Code"
                        Command="{Binding KillRobotCommand}"
                        IsEnabled="{Binding KillEnabled}"
                        HorizontalAlignment="Left"/>
                <Button Content="Launch _Camera Stream"
                        Command="{Binding LaunchCameraStreamCommand}"
                        IsEnabled="{Binding CameraEnabled}"
                        HorizontalAlignment="Left"/>
              </StackPanel>
            </TabItem>
          </TabControl>
          
          <!-- Robot Info Label and TextBox -->
          <StackPanel Grid.Column="1">
            <TextBlock Text="Robot Info" 
                       FontWeight="SemiBold" FontSize="12"
                       Margin="0,0,0,2"/>
            <TextBox Classes="readonly"
                     Text="{Binding RobotInfoText}"
                     Background="#8DB4D8"
                     FontSize="11"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     BorderThickness="1"
                     MinWidth="160"
                     MinHeight="90"/>
          </StackPanel>
        </Grid>
        
        <!-- Row 4, Col 0: Auto Button -->
        <Button Grid.Row="4" Grid.Column="0"
                Content="Auto"
                Command="{Binding SendAutonCommand}"
                IsVisible="{Binding AutonVisible}"
                IsEnabled="{Binding AutonEnabled}"
                FontSize="20"
                HorizontalAlignment="Right"
                Width="97" 
                Margin="0,12"/>
        
        <!-- Row 4, Col 1: Teleop Button -->
        <Button Grid.Row="4" Grid.Column="1"
                Content="Teleop"
                Command="{Binding SendTeleopCommand}"
                IsVisible="{Binding TeleopVisible}"
                IsEnabled="{Binding TeleopEnabled}"
                FontSize="20"
                HorizontalAlignment="Left"
                Width="97" 
                Margin="0,12"/>
        
        <!-- Row 4, Col 2: Disable Button -->
        <Button Grid.Row="4" Grid.Column="2"
                Content="Disable"
                Command="{Binding SendDisableCommand}"
                IsVisible="{Binding DisableVisible}"
                IsEnabled="{Binding DisableEnabled}"
                Background="Tomato"
                FontSize="20"
                HorizontalAlignment="Center"
                Width="133" 
                Margin="0,12"/>
        
        <!-- Row 5: Console Label and Clear Button -->
        <TextBlock Grid.Row="5" Grid.Column="0"
                   Text="Console"
                   FontWeight="SemiBold" FontSize="14"
                   VerticalAlignment="Bottom"/>
        
        <Button Grid.Row="5" Grid.Column="3"
                Content="Clear Console"
                Command="{Binding ClearConsoleCommand}"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"/>
        
        <!-- Row 6: Console (spans all columns) -->
        <Border Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="4"
                Background="#1C1C1C"
                BorderBrush="Gray"
                BorderThickness="1"
                Margin="0,4">
          <ScrollViewer x:Name="ConsoleScroller"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ConsoleMessages}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Text}"
                             Foreground="{Binding Color}"
                             FontFamily="Cascadia Code, Consolas, monospace"
                             FontSize="14"
                             TextWrapping="Wrap"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
        
        <!-- Row 2-4, Col 3: Connection Tips (only when disconnected AND ShowTips is true) -->
        <Border Grid.Row="2" Grid.Column="3" Grid.RowSpan="3"
                IsVisible="{Binding ShowTipsPanel}"
                Background="#E8F4FD"
                BorderBrush="#B8D4E8"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12"
                Margin="16,0,0,0">
          <StackPanel Spacing="8" VerticalAlignment="Top">
            <TextBlock Text="Quick Start and Tips" FontWeight="SemiBold" FontSize="14"/>
            <TextBlock Text="1. Ensure your robot program is running and then click 'Connect to Robot'"
                       TextWrapping="Wrap" FontSize="12"/>
            <TextBlock Text="2. You can control your robot with keyboard combos ('[]\' to enable and enter to disable) "
                       TextWrapping="Wrap" FontSize="12"/>
            <TextBlock Text=""
                       TextWrapping="Wrap" FontSize="12"/>
            <TextBlock Text="Tip! You can disable this box under Preferences"
                       TextWrapping="Wrap" FontSize="12"/>
          </StackPanel>
        </Border>
      </Grid>
    </Panel>
  </DockPanel>
</UserControl>